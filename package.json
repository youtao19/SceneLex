{
  "name": "wordscene",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend & npm run dev:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ocr": "cd ocr-service && uv run uvicorn main:app --host 127.0.0.1 --port 8001",
    "dev:ocr:reload": "cd ocr-service && uv run uvicorn main:app --host 127.0.0.1 --port 8001 --reload",
    "dev:db-tunnel": "sh ./scripts/start-db-tunnel.sh",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "test": "npm --prefix frontend run test && npm --prefix backend run test",
    "verify": "npm run typecheck && npm test && npm run build",
    "start:prod": "node backend/dist/server.js",
    "start:tunnel": "sh ./scripts/start-tunnel.sh",
    "health:check": "sh ./scripts/check-health.sh",
    "health:check:prod": "sh ./scripts/check-health.sh https://scenlex.cn",
    "handover:check": "sh ./scripts/check-handover.sh",
    "dict:download": "npm --prefix backend run dict:download",
    "wordbook:import": "sh ./scripts/wordbook-import.sh",
    "prewarm:cet6": "npm --prefix backend run wordbook:prewarm:cet6",
    "install:all": "npm install",
    "key:create": "sh ./scripts/create-access-key.sh",
    "user:suspend": "sh ./scripts/user-suspend.sh",
    "user:resume": "sh ./scripts/user-resume.sh",
    "user:renew": "sh ./scripts/user-renew.sh",
    "user:promote": "sh ./scripts/user-promote.sh",
    "user:demote": "sh ./scripts/user-demote.sh"
  },
  "dependencies": {
    "playwright": "^1.59.1"
  }
}
