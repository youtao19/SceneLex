# Backend server
PORT=3003
NODE_ENV=development

# PostgreSQL
# 格式示例：
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE

# 启动时是否自动执行数据库迁移，默认 true（线上靠它自动迁移，不要配成 false）。
# 只有本地开发连线上库时才设 false：否则本地未发布的迁移会被直接应用到线上。
# MIGRATE_ON_STARTUP=false

# 用户端点的密钥加密。用户保存过端点后不要随意更换，否则已存的密文解不开。
# 生产环境缺失这项会直接拒绝启动（见 config/env.ts 的 assertProductionConfig）。
USER_API_KEY_SECRET=

# 允许跨域访问 API 的前端来源，逗号分隔。APP_ORIGIN 是它的旧名字，仍可用。
#
# 前端和后端同源部署（本项目默认形态）时可以留空：同源请求不需要 CORS 放行头。
# 只有当前端在别的域名/端口上（分开部署、移动端 WebView 等）才需要填，
# 例如 CORS_ORIGINS=https://app.example.com,https://www.example.com
#
# 注意别把它和 TRUST_PROXY_HOPS 混淆：那个管的是 req.ip 怎么取，不是跨域。
# CORS_ORIGINS=

# 模型端点由用户在设置页自己填，后端不再持有兜底的模型 Key。
# 下面这几项只服务于两个地方：Ollama 预设的地址，以及词卡预热脚本。
# Ollama 预设（走 OpenAI-compatible，地址要带 /v1）
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1

# 词卡预热脚本没有用户身份，只能从环境变量取一组凭证。
# 不设 PREWARM_* 时会回退到 DEEPSEEK_*。
PREWARM_BASE_URL=https://api.deepseek.com/v1
PREWARM_MODEL=deepseek-v4-flash
PREWARM_API_KEY=

# OCR
# OCR_TIMEOUT 是多模态识别超时；tesseract 和 paddle 各自有独立超时。
OCR_TIMEOUT=180000
OCR_SERVICE_URL=http://127.0.0.1:8001/ocr
PADDLE_OCR_TIMEOUT=300000

# Model traffic controls
MODEL_GLOBAL_CONCURRENCY=3
MODEL_USER_CONCURRENCY=1
MODEL_RATE_LIMIT_MAX=10
MODEL_QUEUE_TIMEOUT_MS=30000

# Cloudflare R2 avatar storage
# 留空时头像继续保存到本地 backend/uploads/avatars。
R2_AVATAR_PUBLIC_BASE_URL=https://avatars.scenlex.cn
R2_AVATAR_UPLOAD_URL=https://avatar-upload.scenlex.cn
R2_AVATAR_UPLOAD_TOKEN=
